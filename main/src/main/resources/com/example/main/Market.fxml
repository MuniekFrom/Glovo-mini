        <Text layoutX="33.0" layoutY="388.0" text="Jogurt" wrappingWidth="159.0">
            <font><Font size="24" /></font>
        </Text>
        <Button fx:id="plusJogurt" layoutX="288.0" layoutY="366.0" onAction="#plusJogurt" text="+" />
        <Button fx:id="usunJogurt" layoutX="368.0" layoutY="366.0" onAction="#usunJogurt" text="-" />
