        <Rectangle height="5" layoutY="650" width="600" />

        <Text layoutX="21.0" layoutY="682.0" text="Produkty:"><font><Font size="18" /></font></Text>
        <Text fx:id="produktyTextCena" layoutX="113.0" layoutY="683.0"><font><Font size="18" /></font></Text>
        <Text layoutX="21.0" layoutY="716.0" text="🚚 Dostawa +10 zł"><font><Font size="18" /></font></Text>
        <Text layoutX="24.0" layoutY="765.0" text="🛒 Razem:"><font><Font size="36" /></font></Text>
        <Text fx:id="cenaKoncowaSporzywczy" layoutX="200.0" layoutY="766.0"><font><Font size="36" /></font></Text>

        <Button layoutX="416.0" layoutY="764.0" onAction="#zamowienie" prefHeight="25.0" prefWidth="140.0" styleClass="zamowButton" text="Zamów" />
        <Text fx:id="zamowienieMinimumKwotaText" fill="RED" layoutX="150" layoutY="805" />
    </children>
</AnchorPane>
