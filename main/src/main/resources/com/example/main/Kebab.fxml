<AnchorPane id="AnchorPane" prefHeight="825.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.main.KebabController">
    <children>

        <fx:include source="TopBar.fxml" />

        <ImageView fitHeight="598.0" fitWidth="600.0" layoutY="58.0">
            <image>
                <Image url="@../../../photos/glovo_mini_kopia.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="124.0" fitWidth="114.0" layoutX="64.0" layoutY="81.0" preserveRatio="true">
            <image><Image url="@../../../photos/rollo.png" /></image>
        </ImageView>

        <ImageView fitHeight="63.0" fitWidth="131.0" layoutX="62.0" layoutY="206.0" preserveRatio="true">
            <image><Image url="@../../../photos/pita.png" /></image>
        </ImageView>

        <ImageView fitHeight="114.0" fitWidth="106.0" layoutX="68.0" layoutY="292.0" preserveRatio="true">
            <image><Image url="@../../../photos/box.png" /></image>
        </ImageView>

        <ImageView fitHeight="114.0" fitWidth="106.0" layoutX="68.0" layoutY="420.0" preserveRatio="true">
            <image><Image url="@../../../photos/wrap.png" /></image>
        </ImageView>

        <Button fx:id="powrotPrzycisk" layoutX="102.0" layoutY="14.0" mnemonicParsing="false" onAction="#powrotDoWyboruRestauracji" prefHeight="25.0" prefWidth="76.0" styleClass="powrotButton" text="Powrót" AnchorPane.leftAnchor="90.0" AnchorPane.topAnchor="12.0" />

        <Text layoutX="228.0" layoutY="88.0" text="Rodzaj">
            <font><Font size="18.0" /></font>
        </Text>
        <Text layoutX="494.0" layoutY="88.0" text="Cena">
            <font><Font size="18.0" /></font>
        </Text>

        
        <Text layoutX="228.0" layoutY="148.0" text="Rollo">
            <font><Font size="24" /></font>
        </Text>
        <Button fx:id="dodajRolloBtn" layoutX="330.0" layoutY="126.0" onAction="#addRollo" prefHeight="28" prefWidth="70" styleClass="dodajButton" text="Dodaj" />
