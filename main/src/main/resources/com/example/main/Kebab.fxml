        </Text>
        <Button fx:id="dodajBoxBtn" layoutX="330.0" layoutY="332.0" onAction="#addBox" prefHeight="28" prefWidth="70" styleClass="dodajButton" text="Dodaj" />
        <ComboBox fx:id="rozmiarBox" layoutX="454.0" layoutY="320.0" prefWidth="120" styleClass="comboKebab" AnchorPane.topAnchor="306.0" />
        <ComboBox fx:id="miesoBox" layoutX="454.0" layoutY="344.0" prefWidth="120" styleClass="comboKebab" />
        <Text layoutX="436.0" layoutY="401.0" strokeType="OUTSIDE" strokeWidth="0.0" text="S 35zł | M 43zł | L 51zł">
            <font><Font size="16.0" /></font>
        </Text>

    
        <Text layoutX="227.0" layoutY="470.0" text="Wrap">
