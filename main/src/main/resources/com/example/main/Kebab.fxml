            <font><Font size="16.0" /></font>
        </Text>

        
        <Text layoutX="236.0" layoutY="247.0" text="Pita">
            <font><Font size="24" /></font>
        </Text>
        <Button fx:id="dodajPitaBtn" layoutX="330.0" layoutY="225.0" onAction="#addPita" prefHeight="28" prefWidth="70" styleClass="dodajButton" text="Dodaj" />
