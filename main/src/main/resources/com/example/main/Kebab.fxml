        </Text>

        <Text layoutX="431.0" layoutY="643.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Mięso mieszane +3zł" AnchorPane.topAnchor="620.0">
            <font><Font size="16.0" /></font>
        </Text>

        <ListView fx:id="cartList" layoutX="40.0" layoutY="526.0" prefHeight="89.0" prefWidth="540.0" />

        <Button layoutX="40.0" layoutY="618.0" onAction="#removeSelected" prefHeight="21.0" prefWidth="155.0" styleClass="usunButtonDanger" text="Usuń zaznaczone" AnchorPane.topAnchor="614.0" />

        <Rectangle height="5" layoutY="650" width="600" />

      
        <Text layoutX="20" layoutY="690" text="➕ Dodaj do zamówienia">
            <font><Font size="24" /></font>
        </Text>

        <CheckBox fx:id="sosLagodny" layoutX="20" layoutY="720" onAction="#dodatkiZmiana" text="Łagodny (+4 zł)">
            <font><Font size="18.0" /></font>
        </CheckBox>

        <CheckBox fx:id="sosMieszany" layoutX="20" layoutY="750" onAction="#dodatkiZmiana" text="Mieszany (+5 zł)">
            <font><Font size="18.0" /></font>
        </CheckBox>

        <CheckBox fx:id="sosOstry" layoutX="20" layoutY="779" onAction="#dodatkiZmiana" text="Ostry (+6 zł)">
            <font><Font size="18.0" /></font>
        </CheckBox>

        
        <Text layoutX="308.0" layoutY="684.0" text="🍔 Jedzenie:">
