        <Text fx:id="jedzenieTextCena" layoutX="416.0" layoutY="685.0" wrappingWidth="140.0">
            <font><Font size="18.0" /></font>
        </Text>

        <Text layoutX="308.0" layoutY="715.0" text="🚚 Dostawa +10 zł">
            <font><Font size="18.0" /></font>
        </Text>

        <Text layoutX="310.0" layoutY="769.0" text="🛒 Razem:">
            <font><Font size="36.0" /></font>
        </Text>

        <Text fx:id="cenaKoncowaPizza" layoutX="477.0" layoutY="768.0" wrappingWidth="113.68359375">
            <font><Font size="36.0" /></font>
        </Text>

        <Button layoutX="444.0" layoutY="780.0" onAction="#zamowienieJedzenia" prefHeight="25.0" prefWidth="140.0" styleClass="zamowButton" text="Zamów" AnchorPane.rightAnchor="12.0" />

        <Text fx:id="zamowienieMinimumKwotaText" fill="RED" layoutX="150" layoutY="805" />

